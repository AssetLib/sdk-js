    "verify": "node --check bin/assetlib.mjs && node bin/assetlib.mjs --help"
  },
  "dependencies": {
    "image-size": "2.0.4",
    "typescript": "5.9.3"
  },
  "publishConfig": { "access": "public", "provenance": false },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AssetLib/sdk-js.git",
    "directory": "packages/cli"
  }
}
