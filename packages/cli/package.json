{
  "name": "@assetlib/cli",
  "version": "0.1.1",
  "description": "Register checked-in Assetlib catalogs and bounded code references from application builds.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "assetlib": "bin/assetlib.mjs" },
